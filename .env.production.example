# ==============================================================================
# H&H — Production Environment Variable Configuration
# ==============================================================================
# Copy this file to .env.production on your VPS:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
# ==============================================================================

# 1. Domain & Networking (Caddy Auto-HTTPS & Next.js)
DOMAIN=handh.example.com
ACME_EMAIL=admin@handh.example.com
APP_URL=https://handh.example.com
NEXT_PUBLIC_APP_URL=https://handh.example.com

# 2. Database (PostgreSQL 16)
POSTGRES_USER=hh_admin
POSTGRES_PASSWORD=generate_a_secure_32_char_database_password_here
POSTGRES_DB=hh_prod
DATABASE_URL=postgres://hh_admin:generate_a_secure_32_char_database_password_here@postgres:5432/hh_prod

# 3. Redis (BullMQ Queues & Rate Limiting)
REDIS_URL=redis://redis:6379

# 4. Enterprise Admin Authentication & Session Encryption
# Generate high-entropy 64-character random string: openssl rand -base64 48
ADMIN_SESSION_SECRET=generate_a_random_64_char_hmac_secret_for_sessions
ADMIN_ACCESS_KEY=generate_a_random_32_char_stealth_gateway_key
ADMIN_PASSWORD=generate_a_high_entropy_master_password

# 5. Initial Super Admin Auto-Provisioning (Seeded when admin_users table is empty)
INITIAL_ADMIN_EMAIL=admin@handh.example.com
INITIAL_ADMIN_PASSWORD=generate_a_high_entropy_initial_password_here
INITIAL_ADMIN_ROLE=super_admin

# 6. Enterprise Single Sign-On (SSO) & Corporate Domain Whitelist
# Restrict admin portal login exclusively to your corporate brand domain(s)
ADMIN_ALLOWED_DOMAINS=handh.example.com,brand.com
# Optional: explicitly whitelisted administrator email addresses
ADMIN_ALLOWED_EMAILS=founder@brand.com,ops@brand.com

# Google Workspace OAuth Credentials (Setup at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho Mail OAuth Credentials (Setup at api-console.zoho.in)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in

# 7. Customer Authentication (JWT & Phone Sessions)
AUTH_JWT_SECRET=generate_a_random_64_char_jwt_secret

# 8. Payment Processing (Razorpay India Live Keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_live_webhook_secret_here

# 9. File Storage (Local disk or Cloudflare R2 / AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/public/uploads

# S3 / Cloudflare R2 Credentials (Optional, if STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hh-catalog-production
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_DOMAIN=https://cdn.handh.example.com

# 10. Communications & Notifications
RESEND_API_KEY=re_your_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
WHATSAPP_API_KEY=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# 11. Analytics & Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
