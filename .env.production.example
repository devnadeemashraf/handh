# ==============================================================================
# H&H — Production Environment Variable Configuration
# ==============================================================================
# Copy this file to .env.production on your VPS:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
# ==============================================================================

# 1. Domain & Networking (Caddy Auto-HTTPS & Next.js)
DOMAIN=handh.example.com
ACME_EMAIL=admin@handh.example.com
APP_URL=https://handh.example.com
NEXT_PUBLIC_APP_URL=https://handh.example.com

# 2. Database (PostgreSQL 16)
POSTGRES_USER=hh_admin
POSTGRES_PASSWORD=generate_a_secure_32_char_database_password_here
POSTGRES_DB=hh_prod
DATABASE_URL=postgres://hh_admin:generate_a_secure_32_char_database_password_here@postgres:5432/hh_prod

# 3. Redis (BullMQ Queues & Rate Limiting)
REDIS_URL=redis://redis:6379

# 4. Enterprise Admin Authentication & Session Encryption
# Generate high-entropy 64-character random string: openssl rand -base64 48
ADMIN_SESSION_SECRET=generate_a_random_64_char_hmac_secret_for_sessions
ADMIN_ACCESS_KEY=generate_a_random_32_char_stealth_gateway_key
ADMIN_PASSWORD=generate_a_high_entropy_master_password

# 5. Initial Super Admin Auto-Provisioning (Seeded when admin_users table is empty)
INITIAL_ADMIN_EMAIL=admin@handh.example.com
INITIAL_ADMIN_PASSWORD=generate_a_high_entropy_initial_password_here
INITIAL_ADMIN_ROLE=super_admin

# 6. Enterprise Single Sign-On (SSO) & Corporate Domain Whitelist
# Restrict admin portal login exclusively to your corporate brand domain(s)
ADMIN_ALLOWED_DOMAINS=handh.example.com,brand.com
# Optional: explicitly whitelisted administrator email addresses
ADMIN_ALLOWED_EMAILS=founder@brand.com,ops@brand.com

# Google Workspace OAuth Credentials (Setup at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho Mail OAuth Credentials (Setup at api-console.zoho.in)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in

# 7. Customer Authentication (JWT & Phone Sessions)
AUTH_JWT_SECRET=generate_a_random_64_char_jwt_secret

# 8. Payment Processing (Razorpay India Live Keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_live_webhook_secret_here

# 9. File Storage (Local disk or Cloudflare R2 / AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/public/uploads

# S3 / Cloudflare R2 Credentials (Optional, if STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hh-catalog-production
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_DOMAIN=https://cdn.handh.example.com

# 10. Communications & Notifications
RESEND_API_KEY=re_your_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
WHATSAPP_API_KEY=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# 11. Analytics & Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# 12. Global Brand Identity & On-The-Fly Customization (packages/domain/src/brand)
# Configure custom brand presentation dynamically across web storefront, emails, WhatsApp, and invoices
BRAND_NAME=H&H
NEXT_PUBLIC_BRAND_NAME=H&H
BRAND_LEGAL_NAME="H&H Luxury Modest Wear Private Limited"
BRAND_SHORT_NAME=H&H
BRAND_TAGLINE="Crafted for Grace & Modesty"
BRAND_SUBTITLE="Curated Modest Essentials & Jewelry"
BRAND_SUPPORT_EMAIL=support@handh.example.com
BRAND_SUPPORT_PHONE="+91 40 2355 7890"
BRAND_WHATSAPP=+919876543210
BRAND_INSTAGRAM=handh_official
BRAND_WEBSITE_URL=https://handh.example.com

# 13. Statutory Corporate Identity & Grievance Redressal (DPDP / Consumer Protection Rules)
COMPANY_LEGAL_NAME="H&H Luxury Modest Wear Private Limited"
COMPANY_REGISTERED_ADDRESS="Plot No. 128, Road No. 36, Jubilee Hills, Hyderabad, Telangana 500034, India"
COMPANY_CIN=U18101TG2024PTC189234
COMPANY_GSTIN=36AAACH1234F1Z5
COMPANY_SUPPORT_EMAIL=support@handh.example.com
COMPANY_SUPPORT_PHONE="+91 40 2355 7890"
GRIEVANCE_OFFICER_NAME="Mohammed Irfan"
GRIEVANCE_OFFICER_DESIGNATION="Head of Customer Experience & Grievance Officer"
GRIEVANCE_OFFICER_EMAIL=grievance@handh.example.com
GRIEVANCE_OFFICER_PHONE="+91 40 2355 7890"

# 14. Logistics, Origin Warehouse & Shipping Integrations (E-COM-062, E-COM-067)
WAREHOUSE_NAME="H&H Artisan Atelier"
WAREHOUSE_PHONE="+919876543210"
WAREHOUSE_LINE1="Banjara Hills Road No 10"
WAREHOUSE_LINE2=
WAREHOUSE_CITY="Hyderabad"
WAREHOUSE_STATE="Telangana"
WAREHOUSE_POSTAL_CODE="500034"
WAREHOUSE_COUNTRY="India"

# Cryptographic token secret for tamper-proof guest order receipts (HMAC-SHA256, 32+ chars)
# Generate: openssl rand -hex 32
ORDER_RECEIPT_SECRET=generate_a_random_32_char_receipt_hmac_secret

# Shipping Couriers & Webhooks (Shiprocket, TrackingMore, Manual)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here
TRACKINGMORE_API_KEY=
TRACKINGMORE_WEBHOOK_SECRET=your_trackingmore_webhook_secret_here
MANUAL_WEBHOOK_SECRET=your_manual_webhook_secret_here

# 15. Meta WhatsApp Cloud API (Transactional notifications)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_URL=https://graph.facebook.com

