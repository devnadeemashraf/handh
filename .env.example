# ==============================================================================
# H&H Environment Template (.env.example)
# DO NOT COMMIT ACTUAL SECRETS. Copy this file to .env.local for local development.
# ==============================================================================

# Core Runtime Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database (Authoritative storage for commerce, orders, inventory)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hh_dev

# Redis (BullMQ queue backend and caching/rate limiting)
REDIS_URL=redis://localhost:6379

# Razorpay Credentials (Test keys for development)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_use_in_prod
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Resend Transactional Email API Key
RESEND_API_KEY=re_placeholder_test_key

# Admin Authentication Secret (Must be >= 32 characters in production)
ADMIN_SESSION_SECRET=local_development_insecure_secret_key_must_be_32_chars_long

# Cloudflare R2 / S3-compatible Object Storage (Product media)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=hh-media-dev
R2_PUBLIC_URL=https://media-dev.handh.local

# Observability & Analytics (Optional in local development)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
