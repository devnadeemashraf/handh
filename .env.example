# ==============================================================================
# H&H Environment Template (.env.example)
# DO NOT COMMIT ACTUAL SECRETS. Copy this file to .env.local for local development.
# ==============================================================================

# 1. Core Runtime Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. PostgreSQL Database (Postgres 16 connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hh_dev

# 3. Redis (BullMQ queues, session caching & rate limiting)
REDIS_URL=redis://localhost:6379

# 4. Razorpay India Payment Gateway (Sandbox test keys for development)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_use_in_prod
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# 5. Resend Transactional Email API Key
RESEND_API_KEY=re_placeholder_test_key

# 6. Admin Authentication & Session Security
ADMIN_SESSION_SECRET=local_development_insecure_secret_key_must_be_32_chars_long
ADMIN_ACCESS_KEY=hh_dev_access_key
ADMIN_PASSWORD=hh_admin_secret_pass_2026

# 7. Initial Super Admin Auto-Provisioning (Evaluated on startup/seed if admin_users is empty)
INITIAL_ADMIN_EMAIL=admin@handh.in
INITIAL_ADMIN_PASSWORD=hh_admin_master_password_2026
INITIAL_ADMIN_ROLE=super_admin

# 8. Enterprise Single Sign-On (SSO) & Corporate Domain Gating
# Comma-separated list of corporate domains allowed to access workshop admin portal
ADMIN_ALLOWED_DOMAINS=handh.in,brand.com
# Comma-separated list of explicit whitelisted admin email addresses
ADMIN_ALLOWED_EMAILS=admin@handh.in,support@brand.com

# Google Workspace OAuth Credentials (Optional - configure if using Google SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho Mail OAuth Credentials (Optional - configure if using Zoho SSO)
# Use 'accounts.zoho.in' for India datacenter or 'accounts.zoho.com' for US
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in

# 9. Object Storage (Local Floci on port 4566 or Production Cloudflare R2 / S3)
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=hh-media-dev
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:4566/hh-media-dev

# Cloudflare R2 Alternate configuration (Production)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=hh-media-dev
R2_PUBLIC_URL=https://media-dev.handh.local

# 10. Observability & Analytics (Optional in local development)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# 11. Global Brand Identity & On-The-Fly Customization (packages/domain/src/brand)
# Override core brand presentation dynamically across web storefront, emails, WhatsApp, and invoices
BRAND_NAME=H&H
NEXT_PUBLIC_BRAND_NAME=H&H
BRAND_LEGAL_NAME="H&H Luxury Modest Wear Private Limited"
BRAND_SHORT_NAME=H&H
BRAND_TAGLINE="Crafted for Grace & Modesty"
BRAND_SUBTITLE="Curated Modest Essentials & Jewelry"
BRAND_SUPPORT_EMAIL=support@handh.in
BRAND_SUPPORT_PHONE="+91 40 2355 7890"
BRAND_WHATSAPP=+919876543210
BRAND_INSTAGRAM=handh_official
BRAND_WEBSITE_URL=http://localhost:3000

# 12. Statutory Corporate Identity & Grievance Redressal (DPDP / Consumer Protection Rules)
COMPANY_LEGAL_NAME="H&H Luxury Modest Wear Private Limited"
COMPANY_REGISTERED_ADDRESS="Plot No. 128, Road No. 36, Jubilee Hills, Hyderabad, Telangana 500034, India"
COMPANY_CIN=U18101TG2024PTC189234
COMPANY_GSTIN=36AAACH1234F1Z5
COMPANY_SUPPORT_EMAIL=support@handh.in
COMPANY_SUPPORT_PHONE="+91 40 2355 7890"
GRIEVANCE_OFFICER_NAME="Mohammed Irfan"
GRIEVANCE_OFFICER_DESIGNATION="Head of Customer Experience & Grievance Officer"
GRIEVANCE_OFFICER_EMAIL=grievance@handh.in
GRIEVANCE_OFFICER_PHONE="+91 40 2355 7890"

# 13. Logistics, Origin Warehouse & Shipping Integrations (E-COM-062, E-COM-067)
WAREHOUSE_NAME="H&H Artisan Atelier"
WAREHOUSE_PHONE="+919876543210"
WAREHOUSE_LINE1="Banjara Hills Road No 10"
WAREHOUSE_LINE2=
WAREHOUSE_CITY="Hyderabad"
WAREHOUSE_STATE="Telangana"
WAREHOUSE_POSTAL_CODE="500034"
WAREHOUSE_COUNTRY="India"

# Cryptographic token secret for tamper-proof guest order receipts (HMAC-SHA256, 16+ chars)
ORDER_RECEIPT_SECRET=local_order_receipt_secret_16chars_min

# Shipping Couriers & Webhooks (Optional in dev; Shiprocket, TrackingMore, Manual)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
SHIPROCKET_WEBHOOK_SECRET=
TRACKINGMORE_API_KEY=
TRACKINGMORE_WEBHOOK_SECRET=
MANUAL_WEBHOOK_SECRET=

# 14. Meta WhatsApp Cloud API (Transactional notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_URL=https://graph.facebook.com

