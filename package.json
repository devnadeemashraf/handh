{
  "name": "hh-platform",
  "version": "0.1.0",
  "private": true,
  "description": "H&H E-Commerce Platform - Modular Monolith",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --filter=@hh/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter=@hh/db db:generate",
    "db:migrate": "pnpm --filter=@hh/db db:migrate",
    "db:clean": "pnpm --filter=@hh/db db:clean",
    "db:reset": "pnpm --filter=@hh/db db:reset",
    "db:seed": "pnpm --filter=@hh/db db:seed",
    "db:push": "pnpm --filter=@hh/db db:push",
    "clean": "pnpm -r --parallel exec rm -rf dist .next .turbo node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.2.1",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
